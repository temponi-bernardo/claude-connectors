# Variáveis dos conectores para rodar localmente (no Claude Desktop vêm do formulário da extensão).
# Copie para .env e preencha. Nunca versione o .env.

# canvas-puc
CANVAS_BASE_URL=https://pucminas.instructure.com
CANVAS_ALLOW_WRITE=false
# Reserva caso o login pelo navegador falhe (Conta > Configurações > Novo token de acesso)
CANVAS_API_TOKEN=
# CANVAS_LOGIN_BUTTON=pucminas.edu.br
# CANVAS_DATA_DIR=
