# Variáveis dos conectores para rodar localmente (no Claude Desktop vêm do formulário da extensão).
# Copie para .env e preencha. Nunca versione o .env.

# canvas-puc
CANVAS_BASE_URL=https://pucminas.instructure.com
CANVAS_ALLOW_WRITE=false
# Reserva caso o login pelo navegador falhe (Conta > Configurações > Novo token de acesso)
CANVAS_API_TOKEN=
# CANVAS_LOGIN_BUTTON=pucminas.edu.br
# CANVAS_DATA_DIR=

# canvas-puc remoto (server/remote.js, ADR 0009) — também usa CANVAS_BASE_URL e CANVAS_ALLOW_WRITE
# Endereço público em https (obrigatório no Docker; no Worker, opcional: vale o endereço *.workers.dev)
PUBLIC_URL=
# 32 bytes aleatórios em base64: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
SEAL_KEY=
PORT=8080
# Hosts aceitos como retorno do OAuth (padrão: claude.ai,claude.com,localhost)
# OAUTH_REDIRECT_HOSTS=

# Deploy do Worker (npm run worker:deploy, ADR 0010): token com o modelo "Edit Cloudflare Workers"
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# gmail remoto (connectors/gmail, ADR 0014) — no Worker são secrets: npx wrangler secret put <NOME> --config connectors/gmail/wrangler.toml
# Valores de exemplo só para `npm run gmail:dev` (vão em connectors/gmail/.dev.vars, ignorado pelo git).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 bytes aleatórios em base64 (cifra os refresh tokens do Google no KV)
TOKEN_ENC_KEY=
# Opcional (modo privado): só estes e-mails entram, separados por vírgula. Vazio = público, qualquer conta Google
ALLOWED_EMAILS=
# 32+ caracteres aleatórios (assina o cookie do consentimento lembrado)
CONSENT_SECRET=

# whatsapp (Worker + Containers, ADR 0015) — no Worker estes são secrets (wrangler secret put), não .env
# SEAL_KEY também vale para o WhatsApp (selos do OAuth e do /pair)
# 32+ caracteres aleatórios: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
BRIDGE_TOKEN=
# 32 bytes em base64 (chave dos backups no R2; guarde num cofre)
SNAPSHOT_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# ALLOWED_EMAILS (no Worker do WhatsApp): e-mail(s) verificado(s) do dono no GitHub
# Envio ligado no wrangler.toml (confirmação a cada mensagem e limite por hora); allowlist opcional
# (números com DDI ou JIDs; vazia = qualquer contato ou grupo)
# ENABLE_SEND=true
# SEND_ALLOWLIST=
