# Variáveis dos conectores para rodar localmente (no Claude Desktop vêm do formulário da extensão).
# Copie para .env e preencha. Nunca versione o .env.

# canvas-puc
CANVAS_BASE_URL=https://pucminas.instructure.com
CANVAS_ALLOW_WRITE=false
# Reserva caso o login pelo navegador falhe (Conta > Configurações > Novo token de acesso)
CANVAS_API_TOKEN=
# CANVAS_LOGIN_BUTTON=pucminas.edu.br
# CANVAS_DATA_DIR=

# canvas-puc remoto (server/remote.js, ADR 0009) — também usa CANVAS_BASE_URL e CANVAS_ALLOW_WRITE
# Endereço público em https (obrigatório no Docker; no Worker, opcional: vale o endereço *.workers.dev)
PUBLIC_URL=
# 32 bytes aleatórios em base64: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
SEAL_KEY=
PORT=8080
# Hosts aceitos como retorno do OAuth (padrão: claude.ai,claude.com,localhost)
# OAUTH_REDIRECT_HOSTS=

# Deploy do Worker (npm run worker:deploy, ADR 0010): token com o modelo "Edit Cloudflare Workers"
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
