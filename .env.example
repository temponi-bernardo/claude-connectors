# Connector variables for local development. Copy to .env and fill in. Never commit .env.

# canvas-puc remote server (server/remote.js, ADR 0009)
CANVAS_BASE_URL=https://pucminas.instructure.com
CANVAS_ALLOW_WRITE=false
# Public https address (required in Docker; optional on the Worker, which uses its *.workers.dev address)
PUBLIC_URL=
# 32 random bytes in base64: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
SEAL_KEY=
PORT=8080
# Hosts accepted as OAuth redirect targets (default: claude.ai,claude.com,localhost)
# OAUTH_REDIRECT_HOSTS=

# Worker deploy (npm run worker:deploy, ADR 0010): token from the "Edit Cloudflare Workers" template
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# gmail remote (connectors/gmail, ADR 0014) — on the Worker these are secrets: npx wrangler secret put <NAME> --config connectors/gmail/wrangler.toml
# Example values only for `npm run gmail:dev` (they go in connectors/gmail/.dev.vars, ignored by git).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes in base64 (encrypts the Google refresh tokens in KV)
TOKEN_ENC_KEY=
# Optional (private mode): only these emails may sign in, comma-separated. Empty = public, any Google account
ALLOWED_EMAILS=
# 32+ random characters (signs the remembered-consent cookie)
CONSENT_SECRET=

# whatsapp (Worker + Containers, ADR 0015) — on the Worker these are secrets (wrangler secret put)
# SEAL_KEY is also used by WhatsApp (OAuth and /pair seals)
# 32+ random characters: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
BRIDGE_TOKEN=
# 32 bytes in base64 (R2 backup key; keep it in a vault)
SNAPSHOT_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# ALLOWED_EMAILS (on the WhatsApp Worker): the owner's verified GitHub email — ONE (single tenant).
# Several emails of the same owner only with ALLOW_SHARED_OWNER=true
# ALLOW_SHARED_OWNER=false
# Sending is enabled in wrangler.toml (confirmation for each message and an hourly limit); optional allowlist
# (numbers with country code or JIDs; empty = any contact or group)
# ENABLE_SEND=true
# SEND_ALLOWLIST=
