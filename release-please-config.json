{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "draft": true,
  "changelog-path": "CHANGELOG.md",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "changelog-sections": [
    { "type": "feat", "section": "Adicionado" },
    { "type": "fix", "section": "Corrigido" },
    { "type": "perf", "section": "Alterado" },
    { "type": "revert", "section": "Removido" },
    { "type": "refactor", "section": "Alterado", "hidden": true },
    { "type": "docs", "section": "Documentação", "hidden": true },
    { "type": "test", "hidden": true },
    { "type": "chore", "hidden": true },
    { "type": "ci", "hidden": true },
    { "type": "build", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "claude-connectors"
    }
  }
