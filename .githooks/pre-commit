#!/usr/bin/env sh
# Before every commit, only the fast part: lint/format on the staged files and docs:check (which includes
# "every function has a test"). Types and tests run once per PR in `npm run pr:check` (ADR 0029).
# Do not skip it (blocked by Claude Code): fix it.
set -e
# No GitHub Actions (ADR 0006): the checks run locally.
if git diff --cached --name-only --diff-filter=ACMR | grep -q '^\.github/workflows/'; then
  echo "pre-commit: files in .github/workflows/ are not allowed; the checks run locally (ADR 0006)." >&2
  exit 1
fi
npx --no-install lint-staged
npm run -s docs:check
