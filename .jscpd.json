{
  "threshold": 0,
  "minTokens": 50,
  "minLines": 5,
  "reporters": ["consoleFull"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/*.test.ts",
    "**/fixtures/**",
    "package-lock.json",
    "CHANGELOG.md",
    "docs/FUNCTIONS.md",
    "docs/adr/**",
    "connectors/*/server/**",
    "connectors/*/package-lock.json",
    "connectors/*/.claude-plugin/**",
    "connectors/*/.mcp.json"
  ],
  "format": ["typescript", "javascript", "markdown", "json", "yaml"],
  "gitignore": true,
  "exitCode": 1
}
