{
  "name": "claude-connectors",
  "version": "0.1.0",
  "description": "Conectores MCP para o Claude, empacotados como extensões .mcpb, começando pelo Canvas da PUC Minas.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack": "tsx tools/pack/cli.ts",
    "pack:all": "tsx tools/pack/cli.ts --all",
    "worker:dev": "wrangler dev --config connectors/canvas-puc/wrangler.toml",
    "worker:deploy": "wrangler deploy --config connectors/canvas-puc/wrangler.toml",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dup:check": "jscpd",
    "docs:generate": "tsx tools/docs/cli.ts generate",
    "docs:check": "tsx tools/docs/cli.ts check",
    "secrets:check": "sh scripts/secrets-check.sh",
    "check": "npm run format && npm run lint && npm run typecheck && npm run test:coverage && npm run docs:check && npm run dup:check && npm run secrets:check",
    "pr:check": "sh scripts/pr-check.sh"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jscpd": "^5.4.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright-core": "^1.64.1",
    "zod": "^3.25.76"
  }
}
