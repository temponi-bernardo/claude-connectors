{
  "name": "claude-connectors",
  "version": "0.2.1",
  "description": "Remote MCP connectors for Claude, installed from the plugin marketplace: PUC Minas Canvas, multi-account Gmail, self-hosted WhatsApp and Spotify.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p connectors/canvas-puc/src/plan/page/tsconfig.json --noEmit",
    "build": "tsx tools/bundle/cli.ts",
    "worker:dev": "wrangler dev --config connectors/canvas-puc/wrangler.toml",
    "worker:deploy": "wrangler deploy --config connectors/canvas-puc/wrangler.toml && npm run -s smoke -- canvas-puc",
    "gmail:dev": "wrangler dev --config connectors/gmail/wrangler.toml",
    "gmail:deploy": "wrangler deploy --config connectors/gmail/wrangler.toml && npm run -s smoke -- gmail",
    "whatsapp:dev": "wrangler dev --config connectors/whatsapp/wrangler.toml",
    "whatsapp:deploy": "wrangler deploy --config connectors/whatsapp/wrangler.toml && npm run -s smoke -- whatsapp",
    "whatsapp:build": "wrangler deploy --dry-run --containers-rollout=none --config connectors/whatsapp/wrangler.toml",
    "whatsapp:image": "wrangler deploy --dry-run --config connectors/whatsapp/wrangler.toml",
    "spotify:dev": "wrangler dev --config connectors/spotify/wrangler.toml",
    "spotify:deploy": "wrangler deploy --config connectors/spotify/wrangler.toml && npm run -s smoke -- spotify",
    "smoke": "tsx tools/smoke/cli.ts",
    "bridge:test": "sh scripts/bridge-test.sh",
    "plugin:validate": "sh scripts/plugin-validate.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dup:check": "jscpd",
    "docs:generate": "tsx tools/docs/cli.ts generate",
    "docs:check": "tsx tools/docs/cli.ts check",
    "secrets:check": "sh scripts/secrets-check.sh",
    "check": "npm run format && npm run lint && npm run typecheck && npm run test:coverage && npm run docs:check && npm run dup:check && npm run secrets:check",
    "pr:check": "sh scripts/pr-check.sh",
    "plan:e2e": "node scripts/plan-e2e.mjs"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jscpd": "^5.4.3",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.166.0"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "htmlparser2": "^12.0.0",
    "zod": "^3.25.76"
  }
}
