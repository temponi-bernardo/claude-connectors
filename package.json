{
  "name": "template-new-project",
  "version": "0.1.0",
  "description": "Template de repositório para projetos desenvolvidos com Claude Code: documentação como fonte da verdade, checagens automáticas e TDD.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dup:check": "jscpd",
    "docs:generate": "tsx tools/docs/cli.ts generate",
    "docs:check": "tsx tools/docs/cli.ts check",
    "secrets:check": "sh scripts/secrets-check.sh",
    "init": "tsx tools/init/cli.ts",
    "check": "npm run format && npm run lint && npm run typecheck && npm run test:coverage && npm run docs:check && npm run dup:check && npm run secrets:check"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jscpd": "^5.4.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
